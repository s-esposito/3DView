{
  "name": "3dview",
  "displayName": "3DView",
  "description": "View COLMAP reconstructions, 3D meshes, point clouds, 3D Gaussian splats and 3D point tracks in the editor.",
  "version": "1.0.5",
  "publisher": "sesposito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-esposito/3DView.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "colmap",
    "photogrammetry",
    "sfm",
    "gaussian splatting",
    "3dgs",
    "point cloud",
    "mesh",
    "ply",
    "three.js",
    "3d"
  ],
  "homepage": "https://github.com/s-esposito/3DView",
  "bugs": {
    "url": "https://github.com/s-esposito/3DView/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "3dview",
          "title": "3DView",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "3dview": [
        {
          "id": "3dview.welcome",
          "name": "3DView"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "3dview.welcome",
        "contents": "View a COLMAP reconstruction as a colored point cloud with camera poses.\n[Open Reconstruction](command:3dview.openReconstruction)\n\nOr load an asset — a mesh (glTF / GLB / OBJ / PLY), a point cloud (PLY), a 3DGS splat (PLY / SPLAT / SPZ / KSPLAT), or 3D point tracks (NPZ / NPY) — into the scene.\n[Open Asset](command:3dview.openAsset)\n\nOr load a whole folder of asset files at once — every mesh / cloud / splat / track file in it, offered as one temporal item you can scrub through.\n[Open Asset Folder](command:3dview.openAssetFolder)\n\nOr just open an empty viewer.\n[Open Viewer](command:3dview.openViewer)\n\nTip: drag a folder or an asset file here to open it, or right-click one in the Explorer and pick Open in 3DView. Recently opened items appear in this panel."
      }
    ],
    "commands": [
      {
        "command": "3dview.openReconstruction",
        "title": "3DView: Open Reconstruction",
        "icon": "$(folder-opened)"
      },
      {
        "command": "3dview.openAsset",
        "title": "3DView: Open Asset",
        "icon": "$(file)"
      },
      {
        "command": "3dview.openAssetFolder",
        "title": "3DView: Open Asset Folder",
        "icon": "$(folder-library)"
      },
      {
        "command": "3dview.openViewer",
        "title": "3DView: Open Empty Viewer",
        "icon": "$(empty-window)"
      },
      {
        "command": "3dview.openFromExplorer",
        "title": "Open in 3DView"
      },
      {
        "command": "3dview.openRecent",
        "title": "3DView: Open Recent"
      },
      {
        "command": "3dview.removeRecent",
        "title": "Remove from Recents",
        "icon": "$(close)"
      },
      {
        "command": "3dview.revealRecent",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "3dview.clearRecents",
        "title": "3DView: Clear Recents",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "3dview.openReconstruction", "when": "view == 3dview.welcome", "group": "navigation@1" },
        { "command": "3dview.openAsset", "when": "view == 3dview.welcome", "group": "navigation@2" },
        { "command": "3dview.openAssetFolder", "when": "view == 3dview.welcome", "group": "navigation@3" },
        { "command": "3dview.openViewer", "when": "view == 3dview.welcome", "group": "navigation@4" },
        { "command": "3dview.clearRecents", "when": "view == 3dview.welcome", "group": "1_recents@1" }
      ],
      "view/item/context": [
        { "command": "3dview.revealRecent", "when": "view == 3dview.welcome && viewItem == recent", "group": "navigation@1" },
        { "command": "3dview.removeRecent", "when": "view == 3dview.welcome && viewItem == recent", "group": "navigation@2" }
      ],
      "explorer/context": [
        {
          "command": "3dview.openFromExplorer",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(glb|gltf|obj|ply|splat|spz|ksplat|npz|npy)$/i",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        { "command": "3dview.openFromExplorer", "when": "false" },
        { "command": "3dview.openRecent", "when": "false" },
        { "command": "3dview.removeRecent", "when": "false" },
        { "command": "3dview.revealRecent", "when": "false" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit -p ./tsconfig.test.json",
    "clean": "rm -rf out",
    "test": "node esbuild.js --test && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@3dview/core": "*",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
